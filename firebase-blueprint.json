{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with identification, purchases, and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "purchasedProductIds": { "type": "array" },
        "savedProductIds": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    },
    "CustomerEnquiry": {
      "title": "CustomerEnquiry",
      "description": "Customer support enquiry message thread item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "message": { "type": "string", "maxLength": 4000 },
        "sender": { "type": "string", "enum": ["user", "agent"] },
        "timestamp": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "message", "sender"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/enquiries/{enquiryId}": {
      "schema": "CustomerEnquiry",
      "description": "Customer support conversation message records"
    }
  }
}
